# The resume variant that keeps the phone number. Built with
#   node resume/build.js --with-phone      (or: pwsh resume/build.ps1 -WithPhone)
# for sending directly to an employer. It is deliberately never committed:
# this repo is public, and git history is permanent, so anything published
# here stays retrievable even after a later deletion.
Andrew_Merritt_Resume_full.pdf

# Scratch files the build renders through (see resume/build.js). Removed when
# the build exits; listed here in case a run is killed mid-way.
resume/.build-*
